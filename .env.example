POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
POSTGRES_DB=homelab_assistant
EVOLUTION_API_KEY=your_evolution_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Modelo do Gemini (opcional; padrão: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
# Modelo de contingência para quando o principal estiver sobrecarregado (opcional; ex.: gemini-3.7-flash)
GEMINI_FALLBACK_MODEL=

# Administrador: DDI + DDD + número, só dígitos (ex.: 5561999999999)
ADMIN_PHONE_NUMBER=5561999999999
# Outros números autorizados, separados por vírgula (opcional)
ALLOWED_PHONE_NUMBERS=
# Segredo do webhook (gere com: openssl rand -hex 32)
WEBHOOK_TOKEN=change_me_with_openssl_rand_hex_32
